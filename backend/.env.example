APP_NAME="FitNova AI"
DEBUG=false
ENVIRONMENT=development
PORT=8000
ALLOWED_ORIGINS=your_render_app_link
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="fitnova_db"
SECRET_KEY=your_secure_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_ROUTER_MODEL="openai/gpt-oss-20b"
GROQ_FALLBACK_API_KEY=your_api_key_here
GROQ_FALLBACK_MODEL="openai/gpt-oss-20b"
CHROMA_PERSIST_DIRECTORY="./chroma_db"
CHROMA_COLLECTION_NAME="fitnova_knowledge"
SQLITE_DB_PATH="fitnova_nutrition.db"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
